# ==============================================================================
# AIRSPACE Global Environment Variables Template
# Copy this file to .env and configure secret parameters.
# ==============================================================================

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=production

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_production_password
POSTGRES_DB=airspace
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Production Database URL Override
# DATABASE_URL=postgresql://postgres:password@postgres:5432/airspace

# AI Provider Configuration
# Optional: Set this to enable real OpenAI/Gemini handwriting and intent parsing
# AIRSPACE_AI_API_KEY=your_production_api_key_here

# Frontend Environment Configuration (must start with NEXT_PUBLIC_ for client access)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/spatial
