# ==============================================================================
# AIRSPACE Backend Environment Variables Template
# Copy this file to .env inside apps/backend/ and configure.
# ==============================================================================

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_production_password
POSTGRES_DB=airspace
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# DATABASE_URL=postgresql://postgres:password@postgres:5432/airspace
# AIRSPACE_AI_API_KEY=your_production_api_key_here
